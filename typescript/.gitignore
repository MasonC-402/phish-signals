npm-debug.log*

# Compiled output from the TypeScript sources. tsconfig.json builds src/*.ts to
# dist/ (with declarations) for publishing, and a separate tsconfig.test.json
# compiles src/**/*.ts + test/**/*.ts in place (no outDir) so `node --test` can
# run test/*.js directly. Both are built on demand, never checked in.
/dist/
/src/**/*.js
/test/**/*.js
